# Normalize line endings
* text=auto

# Code and text
*.cs      text diff=csharp
*.shader  text
*.hlsl    text
*.json    text
*.md      text

# Unity YAML assets — use Unity's Smart Merge (UnityYAMLMerge) if configured
*.unity   text merge=unityyamlmerge eol=lf
*.prefab  text merge=unityyamlmerge eol=lf
*.asset   text merge=unityyamlmerge eol=lf
*.mat     text merge=unityyamlmerge eol=lf
*.anim    text merge=unityyamlmerge eol=lf
*.controller text merge=unityyamlmerge eol=lf
*.meta    text merge=unityyamlmerge eol=lf

# Binary assets
*.png  binary
*.jpg  binary
*.jpeg binary
*.psd  binary
*.tga  binary
*.fbx  binary
*.blend binary
*.wav  binary
*.mp3  binary
*.ogg  binary
*.ttf  binary
*.otf  binary

# Large binary assets: once Git LFS is installed (brew install git-lfs && git lfs install),
# replace the "binary" lines above with e.g.:
# *.psd filter=lfs diff=lfs merge=lfs -text
