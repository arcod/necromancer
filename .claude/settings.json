{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git branch:*)",
      "Bash(ls:*)",
      "Bash(dotnet build:*)"
    ],
    "deny": [
      "Read(./Library/**)",
      "Read(./Temp/**)",
      "Read(./Obj/**)",
      "Read(./Logs/**)",
      "Read(./Build/**)",
      "Read(./Builds/**)",
      "Edit(./Library/**)",
      "Edit(./Temp/**)",
      "Edit(./ProjectSettings/ProjectVersion.txt)"
    ]
  }
}
