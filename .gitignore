# Unity projects can live at the repo root or one folder down
# (e.g. DOTS_Scratch/), so each rule is listed for both locations.

# ---- Unity generated ----
/[Ll]ibrary/
/*/[Ll]ibrary/
/[Tt]emp/
/*/[Tt]emp/
/[Oo]bj/
/*/[Oo]bj/
