/[Aa]ssets/[Aa]ddressable[Aa]ssets[Dd]ata/*/*.bin*
/[Aa]ssets/AssetStoreTools*
.consulo/
ExportedObj/

# IDE-generated project files (Unity regenerates these)
*.csproj
*.unityproj
